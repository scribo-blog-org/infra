#!/bin/sh
# Поднять или остановить стейдж. Образы и env не удаляет.
set -eu
cd "$(dirname "$0")"

compose() {
  docker compose -f docker-compose.stage.yml "$@"
}

case "${1:-}" in
  up)
    compose pull
    compose up -d
    ;;
  down)
    compose down
    ;;
  *)
    echo "usage: ./stage up|down" >&2
    exit 1
    ;;
esac
