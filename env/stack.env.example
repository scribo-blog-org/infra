# Копируется в /srv/scribo/<окружение>/stack.env.
#
# Этот файл читает сам docker compose, на хосте, ещё до создания контейнеров:
# отсюда берутся подстановки ${...} в compose.yml. Не путать с env/*.env,
# которые compose только передаёт внутрь контейнеров.
#
# Прод и стейдж отличаются ровно этим файлом.

# Приписка в именах контейнеров (prod-backend) и имя сети (scribo-prod).
# По ней nginx из edge различает окружения.
STACK=prod

# Имя проекта compose. Держит контейнеры окружения отдельной группой в docker ps.
COMPOSE_PROJECT_NAME=scribo-prod

# Какие образы поднимать: latest для прода, staging для стейджа.
# Для откатa можно поставить sha коммита: такие теги тоже публикуются в GHCR.
IMAGE_TAG=latest

# Потолки памяти. На виртуалке с 12 ГБ хватает с запасом обоим окружениям.
MEM_FRONTEND=768m
MEM_BACKEND=768m
MEM_SOCKET=256m
MEM_REDIS=320m
REDIS_MAXMEMORY=256mb

# Mongo в контейнере. По умолчанию выключен: окружение работает с внешней базой.
# Чтобы развернуть свой Mongo, раскомментируйте строку, создайте env/mongo.env
# по образцу и папку mongo (см. README, раздел «Mongo в контейнере»).
# COMPOSE_PROFILES=mongo
MEM_MONGO=1g
MONGO_CACHE_GB=0.5
# По умолчанию 7.0. Версия 8.0 и новее не запускается на ядре Linux 6.19+.
# MONGO_VERSION=7.0
