# Копируется в /srv/scribo/edge/stack.env.
#
# Список окружений, которые обслуживает nginx: <приписка>:<домен>, через пробел.
# Приписка должна совпадать со STACK в stack.env окружения, иначе nginx будет
# искать несуществующие контейнеры. Одна запись — два блока server в конфиге.
STACKS=prod:scribo-blog.duckdns.org stage:scribo-blog-stage.duckdns.org

# Каталог, где лежат сертификаты и webroot для ACME. Всё остальное, что монтирует
# edge, живёт в репозитории.
STATE_DIR=/srv/scribo/edge

MEM_NGINX=64m
