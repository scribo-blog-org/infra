STACKS=prod:scribo.pp.ua stage:scribo-stage.pp.ua

# Media limit per post in MB. Keep equal to POST_MEDIA_MAX_MB in backend.env and
# NEXT_PUBLIC_POST_MEDIA_MAX_MB in frontend.env. nginx allows this + 2 MB for
# POST /api/posts and PATCH /api/posts/:id, for every environment.
POST_MEDIA_MAX_MB=100

STATE_DIR=/srv/scribo/edge

MEM_NGINX=64m
MEM_STATUS=128m
