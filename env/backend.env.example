# Копируется в /srv/scribo/<окружение>/env/backend.env и заполняется секретами.
# PORT и REDIS_URL не нужны: их задаёт compose.yml, он же и перекрывает
# значения отсюда.
#
# Отличия стейджа от прода: DB_NAME, FRONTEND_ORIGIN, API_ORIGIN.
# Остальное совпадает, пока база общая. Загрузки у каждого окружения свои, в томе на машине.

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_KEY=
PASSWORD_SALT=10

MONGODB_URI=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# Без завершающего слэша: это разрешённый CORS origin и база ссылок в письмах.
FRONTEND_ORIGIN=https://scribo.pp.ua
API_ORIGIN=https://scribo.pp.ua

MAIL_SENDER=
MAIL_PASSWORD=

# Каталог загрузок задаёт compose.yml (том scribo-<окружение>-uploads).
# Ссылки на картинки строятся как <API_ORIGIN>/uploads/..., их отдаёт nginx
# из edge прямо с тома. Менять не нужно, пока домен окружения тот же.
# UPLOADS_PUBLIC_URL=
