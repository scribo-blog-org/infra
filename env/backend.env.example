# Копируется в /srv/scribo/<окружение>/env/backend.env и заполняется секретами.
# PORT и REDIS_URL не нужны: их задаёт compose.yml, он же и перекрывает
# значения отсюда.
#
# Отличия стейджа от прода: база (MONGODB_URI или DB_NAME), FRONTEND_ORIGIN, API_ORIGIN.
# Остальное совпадает. Загрузки у каждого окружения свои, в томе на машине.

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_KEY=
PASSWORD_SALT=10

# База: либо свой Mongo в контейнере (MONGODB_URI, профиль mongo в stack.env),
# либо внешний кластер (DB_*). MONGODB_URI приоритетнее: чтобы вернуться на
# внешнюю базу, закомментируйте её.
#   MONGODB_URI=mongodb://scribo:<пароль из mongo.env>@mongo:27017/scribo?authSource=admin
MONGODB_URI=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=

# Без завершающего слэша: это разрешённый CORS origin и база ссылок в письмах.
FRONTEND_ORIGIN=https://scribo.pp.ua
API_ORIGIN=https://scribo.pp.ua

# Бекапы базы и загрузок из админки (вкладка «Бекапы»). На проде true, на стейдже false:
# тогда расписание не стартует и кнопка запуска отвечает отказом.
# Архивы лежат в /srv/scribo/<окружение>/backups, срок хранения и время запуска
# задают BACKUP_KEEP_DAILY_DAYS, BACKUP_KEEP_MONTHS и BACKUP_AT, см. README backend.
BACKUP_ENABLED=true
# Откат на бекап из админки. По умолчанию выключен; включайте на том окружении,
# где он нужен (сначала на стейдже). Без BACKUP_ENABLED=true не работает.
# BACKUP_RESTORE_ENABLED=true

MAIL_SENDER=
MAIL_PASSWORD=

# Каталог загрузок задаёт compose.yml (папка /srv/scribo/<окружение>/uploads на хосте).
# В базе лежит путь /uploads/..., без домена. Картинки отдаёт nginx из edge
# прямо с тома, с того же хоста, что и сайт.
# UPLOADS_PUBLIC_URL=
