# Копируется в /srv/scribo/<окружение>/env/socket.env.
# PORT и REDIS_URL задаёт compose.yml.
#
# JWT_PRIVATE_KEY и JWT_REFRESH_KEY сюда класть нельзя: процесс из-за них
# завершается при старте. Сокет только проверяет подпись публичным ключом.

JWT_PUBLIC_KEY=

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
