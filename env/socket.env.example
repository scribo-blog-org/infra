# Копируется в /srv/scribo/<окружение>/env/socket.env.
# PORT и REDIS_URL задаёт compose.yml.
#
# JWT_PRIVATE_KEY и JWT_REFRESH_KEY сюда класть нельзя: процесс из-за них
# завершается при старте. Сокет только проверяет подпись публичным ключом.

JWT_PUBLIC_KEY=

# Та же база, что у backend. MONGODB_URI приоритетнее DB_USER, DB_PASSWORD и DB_HOST,
# но DB_NAME нужен всегда: socket берёт имя базы только из него (со своим Mongo
# это MONGO_APP_DB из mongo.env).
MONGODB_URI=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
