# Копируется в /srv/scribo/<окружение>/env/frontend.env.
# Читается при старте контейнера и отдаётся в страницу как window.__SCRIBO_ENV,
# в образ не зашивается. После правки контейнер нужно пересоздать.
#
# Все четыре значения зависят от домена, то есть у стейджа они свои.

NEXT_PUBLIC_APP_API_URL=https://scribo.pp.ua
NEXT_PUBLIC_APP_VERCEL_PROJECT_PRODUCTION_URL=scribo.pp.ua
NEXT_PUBLIC_SOCKET_URL=wss://scribo.pp.ua/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
