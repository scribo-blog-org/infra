# Копируется в /srv/scribo/<окружение>/env/mongo.env. Нужен только окружениям
# со своим Mongo в контейнере (COMPOSE_PROFILES=mongo в stack.env).
#
# Значения читаются ОДИН РАЗ, при первом запуске на пустой папке
# /srv/scribo/<окружение>/mongo. Потом пароль меняют в самой базе, а не здесь.

# Администратор базы. Приложение под ним не ходит, он нужен для обслуживания.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=

# Пользователь приложения: readWrite только на свою базу. Эти же значения
# идут в MONGODB_URI в backend.env и socket.env:
#   mongodb://<MONGO_APP_USER>:<MONGO_APP_PASSWORD>@mongo:27017/<MONGO_APP_DB>?authSource=admin
# Пароль без спецсимволов (@ : / ? # %), иначе его придётся кодировать в URI.
MONGO_APP_USER=scribo
MONGO_APP_PASSWORD=
MONGO_APP_DB=scribo
