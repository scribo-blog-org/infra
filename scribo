#!/bin/sh
set -eu

INFRA_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=${SCRIBO_ROOT:-/srv/scribo}
CERTBOT_EMAIL=${CERTBOT_EMAIL:-scribo.blog.dev@gmail.com}
CERTBOT_IMAGE=certbot/certbot
NGINX_IMAGE=nginx:1.27-alpine

usage() {
    cat >&2 <<'TEXT'
usage: scribo <command> [target] [arguments]

  up <target> [service...]      start with fresh images; target all means prod, stage, edge
  down <target>                 stop and remove containers
  pull <target> [service...]    download images
  restart <target> [service...]
  logs <target> [arguments]
  config <target>               print compose with values filled in
  ps [target]                   with no target, show all three
  dc <target> <arguments...>    any docker compose command
  check                         render the nginx config and run nginx -t
  certs                         first certificate issue; edge must be stopped
  renew                         renewal; works while edge is running

targets: prod, stage, edge, all (all is for up, down, pull, restart)
TEXT
    exit 1
}

die() {
    echo "scribo: $1" >&2
    exit 1
}

stacks() {
    [ -f "$ROOT/edge/stack.env" ] || die "missing $ROOT/edge/stack.env"
    sed -n 's/^STACKS=//p' "$ROOT/edge/stack.env" | tail -n 1
}

ensure_networks() {
    for entry in $(stacks); do
        net=scribo-${entry%%:*}
        if ! docker network inspect "$net" >/dev/null 2>&1; then
            docker network create "$net" >/dev/null
        fi
    done
}

compose() {
    target=$1
    shift
    case $target in
        prod | stage)
            [ -f "$ROOT/$target/stack.env" ] || die "missing $ROOT/$target/stack.env"
            SCRIBO_INFRA_DIR=$INFRA_DIR docker compose \
                --project-directory "$ROOT/$target" \
                --env-file "$ROOT/$target/stack.env" \
                -f "$INFRA_DIR/compose.yml" \
                "$@"
            ;;
        edge)
            [ -f "$ROOT/edge/stack.env" ] || die "missing $ROOT/edge/stack.env"
            [ -f "$ROOT/edge/env/status.env" ] || die "missing $ROOT/edge/env/status.env — copy infra/env/status.env.example and set STATUS_USER, STATUS_PASSWORD, STATUS_SECRET"
            STATUS_ENV=$ROOT/edge/env/status.env SCRIBO_ROOT=$ROOT docker compose \
                --env-file "$ROOT/edge/stack.env" \
                -f "$INFRA_DIR/edge/compose.yml" \
                "$@"
            ;;
        *)
            die "unknown target '$target', expected prod, stage, or edge"
            ;;
    esac
}

command=${1:-}
[ -n "$command" ] || usage
shift

if [ "${1:-}" = all ]; then
    case $command in
        up | pull | restart) order="prod stage edge" ;;
        down) order="edge stage prod" ;;
        *) die "all is supported for up, down, pull, and restart" ;;
    esac
    shift
    for target in $order; do
        echo "== $target"
        "$0" "$command" "$target" "$@"
    done
    exit 0
fi

case $command in
    up)
        [ -n "${1:-}" ] || usage
        target=$1
        shift
        if [ "$target" = edge ]; then
            ensure_networks
        fi
        case $target in
            prod | stage) compose "$target" up -d --pull always "$@" ;;
            *) compose "$target" up -d "$@" ;;
        esac
        ;;
    down | pull | restart | logs | config)
        [ -n "${1:-}" ] || usage
        target=$1
        shift
        compose "$target" "$command" "$@"
        ;;
    dc)
        [ -n "${1:-}" ] || usage
        target=$1
        shift
        [ -n "${1:-}" ] || usage
        compose "$target" "$@"
        ;;
    ps)
        if [ -n "${1:-}" ]; then
            compose "$1" ps
        else
            for target in edge prod stage; do
                echo "== $target"
                (compose "$target" ps) || echo "   not configured"
            done
        fi
        ;;
    check)
        docker run --rm \
            -e STACKS="$(stacks)" \
            -v "$INFRA_DIR/edge/nginx.conf:/etc/nginx/nginx.conf:ro" \
            -v "$INFRA_DIR/edge/stack.conf.template:/etc/nginx/stack.conf.template:ro" \
            -v "$INFRA_DIR/edge/snippets:/etc/nginx/snippets:ro" \
            -v "$INFRA_DIR/edge/errors:/usr/share/nginx/errors:ro" \
            -v "$INFRA_DIR/edge/entrypoint.d/10-render-stacks.sh:/docker-entrypoint.d/10-render-stacks.sh:ro" \
            -v "$ROOT/edge/certs:/etc/letsencrypt:ro" \
            --entrypoint sh "$NGINX_IMAGE" \
            -c '/docker-entrypoint.d/10-render-stacks.sh && nginx -t'
        ;;
    certs)
        if [ -n "$(docker ps --filter name=^edge-nginx$ --filter status=running -q)" ]; then
            die "edge is using port 80, run ./scribo down edge first"
        fi
        mkdir -p "$ROOT/edge/certs" "$ROOT/edge/certbot-www"
        for entry in $(stacks); do
            domain=${entry#*:}
            echo "== $domain"
            docker run --rm -p 80:80 \
                -v "$ROOT/edge/certs:/etc/letsencrypt" \
                -v "$ROOT/edge/certbot-www:/var/www/certbot" \
                "$CERTBOT_IMAGE" certonly --standalone \
                -d "$domain" \
                --email "$CERTBOT_EMAIL" --agree-tos --non-interactive
        done
        ;;
    renew)
        docker run --rm \
            -v "$ROOT/edge/certs:/etc/letsencrypt" \
            -v "$ROOT/edge/certbot-www:/var/www/certbot" \
            "$CERTBOT_IMAGE" renew --webroot -w /var/www/certbot --quiet
        compose edge exec nginx nginx -s reload 2>/dev/null || true
        ;;
    *)
        usage
        ;;
esac
